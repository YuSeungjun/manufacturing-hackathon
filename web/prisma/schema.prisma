generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workplace {
  id          String            @id @default(cuid())
  name        String            @unique
  managerCode String
  teams       Team[]
  users       User[]
  equipment   Equipment[]
  cameras     CameraFeed[]
  works       MaintenanceWork[]
  analyses    VideoAnalysis[]
  riskEvents  RiskEvent[]
  restarts    RestartRequest[]
  episodes    StoppageEpisode[]
  snapshots   CameraSnapshot[]
}

model Team {
  id          String            @id @default(cuid())
  name        String
  workArea    String
  workplace   Workplace         @relation(fields: [workplaceId], references: [id])
  workplaceId String
  users       User[]
  works       MaintenanceWork[]
  /// 이 조가 벌점을 받은 사건들
  chargedEvents RiskEvent[]

  @@unique([workplaceId, name])
}

model User {
  id             String    @id @default(cuid())
  employeeNumber String    @unique
  name           String
  passwordHash   String
  /// WORKER(정비 작업자) | OPERATOR(설비 운전 담당) | SAFETY_MANAGER(안전관리자)
  role           String    @default("WORKER")
  approvalStatus String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  workplace      Workplace @relation(fields: [workplaceId], references: [id])
  workplaceId    String
  team           Team?     @relation(fields: [teamId], references: [id])
  teamId         String?
  createdAt      DateTime  @default(now())

  createdWorks     MaintenanceWork[]   @relation("WorkCreatedBy")
  assignedWorks    WorkAssignee[]
  lotoLocks        LotoLock[]
  reviews          Review[]
  analyses         VideoAnalysis[]
  reportedEvents   RiskEvent[]         @relation("RiskReportedBy")
  restartRequests  RestartRequest[]    @relation("RestartRequestedBy")
  restartApprovals RestartRequest[]    @relation("RestartApprovedBy")
  stateLogs        EquipmentStateLog[]
  harnessChecks    RiskEvent[]         @relation("HarnessCheckedBy")
}

/// 압연 라인의 개별 설비. 인터록의 대상 단위다.
model Equipment {
  id          String    @id @default(cuid())
  code        String // "RM-02"
  name        String // "조압연기 2호"
  line        String    @default("") // "열연 1라인"
  workplace   Workplace @relation(fields: [workplaceId], references: [id])
  workplaceId String

  /// CONVEYOR | ROLLING_MILL | OTHER — 화면 문구와 위험구역 기본값이 갈린다
  kind            String    @default("CONVEYOR")
  /// 이 설비가 1분 멈출 때의 생산손실(원). 우리가 추정하지 않는다 — 관리자가 넣는 값이다.
  /// 0 이면 금액 환산을 아예 표시하지 않는다.
  downtimeCostPerMin Int    @default(0)

  /// RUNNING | STOPPED | MAINTENANCE
  runState        String    @default("STOPPED")
  /// CLEAR | BLOCKED — BLOCKED 면 운전 담당자가 재가동할 수 없다.
  interlock       String    @default("CLEAR")
  interlockReason String    @default("")
  interlockedAt   DateTime?
  clearedAt       DateTime?
  createdAt       DateTime  @default(now())

  zones      DangerZone[]
  cameras    CameraFeed[]
  works      MaintenanceWork[]
  analyses   VideoAnalysis[]
  riskEvents RiskEvent[]
  restarts   RestartRequest[]
  stateLogs  EquipmentStateLog[]
  episodes   StoppageEpisode[]
  snapshots  CameraSnapshot[]

  @@unique([workplaceId, code])
}

/// 설비 주변의 끼임 위험구역. 카메라 화면 기준 정규화 폴리곤.
model DangerZone {
  id                String      @id @default(cuid())
  equipment         Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId       String
  camera            CameraFeed? @relation(fields: [cameraId], references: [id])
  /// 폴리곤은 카메라 화각에 종속된다. 어느 화각 기준인지 남겨야 나중에 못 알아보는 일이 없다.
  cameraId          String?
  name              String // "롤 갭 하부"
  /// JSON: [[x,y], ...] 0~1 정규화
  polygon           String      @default("[]")
  /// 이 시간(초) 이상 머무르면 잔류로 본다. 지나가는 것과 구분한다.
  dwellThresholdSec Float       @default(5)
  /// PINCH | ROTATING | TRAVEL | GENERAL
  kind              String      @default("PINCH")
  severity          String      @default("HIGH") // LOW | MEDIUM | HIGH
  /// 컨베이어 상부·점검대 같은 추락 위험 구역. 진입은 AI 가 보고,
  /// 안전대를 실제로 "걸었는지"는 CCTV 로 판정할 수 없어 사람이 증언한다.
  requiresHarness   Boolean     @default(false)
  active            Boolean     @default(true)
  order             Int         @default(0)

  riskEvents RiskEvent[]
}

model CameraFeed {
  id          String     @id @default(cuid())
  workplace   Workplace  @relation(fields: [workplaceId], references: [id])
  workplaceId String
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?
  code        String // "CAM-RM02-N"
  name        String // "조압연 2호 북측"
  /// 구역을 그릴 때 배경으로 쓰는 정지 프레임
  posterPath  String     @default("")

  /// 이 화각이 무엇을 보는가. 수신함 탭이 이걸로 갈린다.
  ///
  /// PINCH — 컨베이어·회전체 구역. 끼임을 본다(진입 × 잔류 × 설비상태).
  /// FALL  — 추락 위험 구역. 안전대 착용을 본다.
  ///
  /// 구역의 requiresHarness 로 추론하지 않고 카메라에 명시한다. 컨베이어에도 상부
  /// 점검대(추락 위험)가 있어서 추론하면 한 카메라가 두 탭에 다 뜬다.
  purpose     String     @default("PINCH")

  active      Boolean    @default(true)

  zones      DangerZone[]
  analyses   VideoAnalysis[]
  riskEvents RiskEvent[]
  snapshots  CameraSnapshot[]

  @@unique([workplaceId, code])
}

/// 정비 작업 허가 = LOTO 대장.
/// 기존 LOTO 를 대체하지 않는다. AI 판정과 함께 인터록의 두 번째 근거가 된다 —
/// "AI가 사람을 봤다"만으로 차단하면 오탐 하나에 라인이 서기 때문이다.
model MaintenanceWork {
  id          String    @id @default(cuid())
  workDate    DateTime
  title       String
  summary     String    @default("")
  /// OPEN | IN_PROGRESS | COMPLETED
  status      String    @default("OPEN")
  startedAt   DateTime?
  endedAt     DateTime?
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String
  workplace   Workplace @relation(fields: [workplaceId], references: [id])
  workplaceId String
  team        Team      @relation(fields: [teamId], references: [id])
  teamId      String
  createdBy   User      @relation("WorkCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())

  assignees WorkAssignee[]
  locks     LotoLock[]
}

/// 이 작업에 실제로 투입되는 사람. 작업조 전원이 아니다.
model WorkAssignee {
  id     String          @id @default(cuid())
  work   MaintenanceWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId String
  user   User            @relation(fields: [userId], references: [id])
  userId String

  @@unique([workId, userId])
}

/// 작업자가 건 개인 시건. 하나라도 안 풀렸으면 재가동은 불가다.
model LotoLock {
  id         String          @id @default(cuid())
  work       MaintenanceWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId     String
  user       User            @relation(fields: [userId], references: [id])
  userId     String
  lockedAt   DateTime        @default(now())
  releasedAt DateTime?

  @@unique([workId, userId])
}

/// 업로드한 CCTV 영상 1건의 분석 결과. 타임라인 재생 화면의 원본.
model VideoAnalysis {
  id          String      @id @default(cuid())
  workplace   Workplace   @relation(fields: [workplaceId], references: [id])
  workplaceId String
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])
  equipmentId String
  camera      CameraFeed? @relation(fields: [cameraId], references: [id])
  cameraId    String?

  jobId         String   @default("")
  status        String   @default("RUNNING") // RUNNING | DONE | ERROR
  error         String   @default("")
  /// VIDEO | FRAMES — 정지 이미지 시퀀스인지 영상인지. 화면 문구와 잔류시간 해석이 갈린다.
  sourceKind    String   @default("VIDEO")
  /// JSON: 이미지 시퀀스일 때 각 장의 Blob 주소. 영상이면 빈 배열이다.
  frameUrls     String   @default("[]")
  videoPath     String
  posterPath    String   @default("")
  durationSec   Float    @default(0)
  sourceFps     Float    @default(0)
  sampledFps    Float    @default(0)
  frameCount    Int      @default(0)
  /// JSON: AnalyzeResult.frames — 타임라인 재생이 이걸 읽는다
  timeline      String   @default("[]")
  /// 어떤 설비 상태 타임라인으로 판정했는지. 없으면 결과를 재현할 수 없다.
  machineStates String   @default("[]")
  zoneStats     String   @default("[]")
  warnings      String   @default("[]")
  modelRepo     String   @default("")
  processingSec Float    @default(0)
  analyzedAt    DateTime @default(now())
  analyzedBy    User     @relation(fields: [analyzedById], references: [id])
  analyzedById  String

  riskEvents RiskEvent[]
  episodes   StoppageEpisode[]
  snapshots  CameraSnapshot[]
}

/// AI가 본 위험. 잔류와 설비 가동/재가동 명령이 겹친 순간.
/// 판단은 하지 않는다 — Review 가 그 몫이다.
model RiskEvent {
  id          String         @id @default(cuid())
  workplace   Workplace      @relation(fields: [workplaceId], references: [id])
  workplaceId String
  equipment   Equipment      @relation(fields: [equipmentId], references: [id])
  equipmentId String
  zone        DangerZone?    @relation(fields: [zoneId], references: [id])
  zoneId      String?
  camera      CameraFeed?    @relation(fields: [cameraId], references: [id])
  cameraId    String?
  analysis    VideoAnalysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisId  String?

  /// AI | MANUAL — MANUAL 은 관리자가 "AI가 놓쳤다"고 올린 건. 미탐율의 분자다.
  source       String  @default("AI")
  reportedBy   User?   @relation("RiskReportedBy", fields: [reportedById], references: [id])
  reportedById String?

  /// ZONE_INTRUSION | PROLONGED_DWELL | LOTO_MISSING
  /// | ENTRY_WHILE_RUNNING | RESTART_WITH_WORKER_INSIDE | MANUAL
  code   String @default("ZONE_INTRUSION")
  /// INFO | CAUTION | WARNING | CRITICAL
  level  String @default("CAUTION")
  /// AI가 만든 한국어 한 문장. 화면에 그대로 나간다.
  reason String @default("")

  enteredAt       DateTime
  detectedAt      DateTime  @default(now())
  clearedAt       DateTime?
  dwellSec        Float     @default(0)
  occupantsAtPeak Int       @default(1)
  /// JSON: [3, 7] — 개인 식별이 아니라 프레임 안의 익명 추적 번호
  trackIds        String    @default("[]")
  clipStartSec    Float?
  clipEndSec      Float?
  peakSec         Float?

  machineState String @default("STOPPED")
  severity     String @default("HIGH")
  confidence   Float  @default(0)

  evidencePath String @default("")
  clipPath     String @default("")
  /// JSON: 정규화 박스 배열
  boxes        String @default("[]")
  /// 판정 당시 폴리곤 스냅샷. 나중에 구역을 고쳐도 근거가 흔들리지 않는다.
  zonePolygon  String @default("[]")

  /// AI 의 안전대 착용 추정. 사건에 붙는 값이고, 체결은 아래 harnessStatus(사람 확인)다.
  /// "" (모델 없음) | WORN | NOT_WORN | UNKNOWN
  /// 빈 문자열과 UNKNOWN 을 구분한다 — 모델이 없는 것과 모델이 못 본 것은 다른 사실이다.
  harnessAiStatus     String @default("")
  harnessAiConfidence Float  @default(0)

  /// 안전대 체결 **확정**. 진입한 구역이 requiresHarness 일 때만 의미가 있다.
  /// NA(해당 없음) | PENDING(확인 필요) | CONFIRMED(걸고 있었다) | MISSING(안 걸었다)
  /// AI 도 체결을 추정하지만(CameraSnapshot.hookVerdict) 확정은 사람이 한다.
  /// AI 가 판정한다는 것과 사람이 확정한다는 것은 다르다 — 이 프로젝트의 다른 모든 판정과 같다.
  harnessStatus      String    @default("NA")
  harnessCheckedAt   DateTime?
  harnessCheckedBy   User?     @relation("HarnessCheckedBy", fields: [harnessCheckedById], references: [id])
  harnessCheckedById String?

  /// 이 건이 실제로 설비를 잠갔는가
  interlockEngaged Boolean   @default(false)
  /// PENDING ─[위험 확정]→ IN_PROGRESS ─┬─[확정]→ CONFIRMED
  ///                                        └─[패스]→ PASSED
  ///    └─[오탐]→ FALSE_POSITIVE   └─[보류]→ HOLD
  ///
  /// 확정이 한 번에 끝나지 않는다. 화면에서 "위험이다" 라고 판단한 시점과 현장을 처리하고
  /// 종결한 시점은 다르고, 그 사이가 IN_PROGRESS 다. 점수는 CONFIRMED 만 감점한다.
  status           String    @default("PENDING")
  /// 진행 중으로 옮긴 시각. 대응 소요시간의 시작점이다.
  startedAt        DateTime?
  /// 벌점 부과·조치 완료로 종결한 시각.
  resolvedAt       DateTime?

  /// 벌점을 받은 작업조. 벌점 부과로 종결할 때 사람이 고른다.
  ///
  /// 설비로 조를 추론하지 않는다 — 한 설비에 여러 조가 붙고, 정비 작업이 등록되지 않은
  /// 조는 아무리 사건을 만들어도 점수가 안 깎인다. 누가 책임지는지는 추론이 아니라
  /// 사람이 정하는 일이다.
  chargedTeam      Team?     @relation(fields: [chargedTeamId], references: [id])
  chargedTeamId    String?
  /// 실제로 깎은 점수. 상수(CONFIRMED_EVENT_PENALTY)가 나중에 바뀌어도 과거 기록은
  /// 그때 깎인 값을 그대로 들고 있어야 한다.
  penaltyPoints    Int       @default(0)
  notifiedAt       DateTime?
  acknowledgedAt   DateTime?
  modelRepo        String    @default("")

  review  Review?
  blocked RestartRequest[] @relation("BlockedBy")
  episode StoppageEpisode? @relation(fields: [episodeId], references: [id])
  /// 어느 정지 에피소드 안에서 벌어진 접근인가. 반복 패턴 집계의 연결고리다.
  episodeId String?
}

/// 사람의 판단. AI 의 의심(RiskEvent)과 분리해서 둔다.
model Review {
  id           String    @id @default(cuid())
  riskEvent    RiskEvent @relation(fields: [riskEventId], references: [id], onDelete: Cascade)
  riskEventId  String    @unique
  reviewedBy   User      @relation(fields: [reviewedById], references: [id])
  reviewedById String
  decision     String // CONFIRMED | FALSE_POSITIVE | HOLD
  comment      String    @default("")
  reviewedAt   DateTime  @default(now())
}

/// 운전 담당자의 재가동 요청과 그 결과. 차단 이력이 곧 이 시스템의 성과 지표다.
model RestartRequest {
  id            String    @id @default(cuid())
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId   String
  workplace     Workplace @relation(fields: [workplaceId], references: [id])
  workplaceId   String
  requestedBy   User      @relation("RestartRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  requestedAt   DateTime  @default(now())
  reason        String    @default("")

  /// ALLOWED | BLOCKED — 인터록 엔진이 즉시 내리는 기계 판정
  decision           String
  decidedAt          DateTime   @default(now())
  blockReason        String     @default("")
  blockedBy          RiskEvent? @relation("BlockedBy", fields: [blockedById], references: [id])
  blockedById        String?
  occupancyAtRequest Int        @default(0)

  /// 차단된 요청에만 붙는 사람의 해제 승인
  approvedBy   User?     @relation("RestartApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?
  approvalNote String    @default("")

  /// OPEN | RESTARTED | CANCELLED | REJECTED
  outcome     String    @default("OPEN")
  restartedAt DateTime?
}

model EquipmentStateLog {
  id          String    @id @default(cuid())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  fromState   String
  toState     String
  /// AI_INTERLOCK | OPERATOR | MANAGER_CLEAR | MAINTENANCE
  cause       String
  note        String    @default("")
  at          DateTime  @default(now())
  actor       User?     @relation(fields: [actorId], references: [id])
  actorId     String?
}

/// 설비가 멈춘 한 사이클. "제품 걸림 → 작업자 접근 → 이물 제거 → 재가동" 을 한 건으로 묶는다.
///
/// AI 는 "제품 걸림" 을 직접 보지 못한다. 걸림 클래스를 학습한 모델이 없고, 있어도 라인마다
/// 걸리는 모양이 다르다. 관측 가능한 것은 (설비가 멈췄다) 와 (위험구역에 사람이 들어왔다)
/// 두 개뿐이고, 이 표는 그 둘을 하나의 사건으로 잇는 자리다. 그래서 이름도 "걸림 감지"가
/// 아니라 "정지 에피소드" 다 — 원인(cause)은 PLC 가 주거나 사람이 고른다.
model StoppageEpisode {
  id          String         @id @default(cuid())
  workplace   Workplace      @relation(fields: [workplaceId], references: [id])
  workplaceId String
  equipment   Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  analysis    VideoAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  analysisId  String?

  /// JAM(제품 걸림) | MAINTENANCE(계획 정비) | OTHER — 계획 정비를 걸림으로 세면 통계가 거짓이 된다
  cause  String @default("JAM")
  /// AI(영상 분석에서 파생) | PLC | MANUAL
  source String @default("AI")

  startedAt   DateTime
  restartedAt DateTime?
  /// 정지 → 재가동까지 걸린 시간. 재가동 전이면 0 이고 아직 진행 중이다.
  recoverySec Float     @default(0)

  /// 이 정지 구간 안에 위험구역 접근이 있었는가.
  /// 반복 패턴의 대상은 "정지"가 아니라 "정지 + 위험접근" 이다.
  riskApproach     Boolean @default(false)
  approachCount    Int     @default(0)
  approachDwellSec Float   @default(0)

  note      String   @default("")
  createdAt DateTime @default(now())

  riskEvents RiskEvent[]

  @@index([equipmentId, startedAt])
  @@index([workplaceId, startedAt])
}

/// CCTV 가 찍어 둔 한 장.
///
/// 이 표가 있어야 이야기가 맞는다. 안전관리자는 자기 컴퓨터에서 사진을 올리는 사람이
/// 아니라, **카메라가 이미 찍어 둔 장면 중에서 볼 것을 고르는** 사람이다.
///
/// 그리고 시각이 여기 붙어 있다는 게 중요하다. 분석할 때 사람이 촬영 시각을 입력하면
/// 오타 하나가 잔류시간을 거짓으로 만든다. 찍힌 순간에 한 번 기록되면 그 뒤로는 데이터다.
model CameraSnapshot {
  id          String     @id @default(cuid())
  workplace   Workplace  @relation(fields: [workplaceId], references: [id])
  workplaceId String
  camera      CameraFeed @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId    String
  /// 카메라가 붙은 설비. 수신함을 설비로 묶어 보기 위한 사본이다.
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId String?

  imagePath String
  /// 찍힌 시각. 실운영에서는 엣지 장치가 준다.
  capturedAt DateTime
  width      Int @default(0)
  height     Int @default(0)

  /// 왜 찍혔는가.
  /// ZONE_APPROACH(위험구역 접근) | MOTION(움직임) | SCHEDULE(주기 촬영) | MANUAL(수동 등록)
  trigger String @default("ZONE_APPROACH")

  /// ── 수신 시점 1차 탐지 ────────────────────────────
  /// 카메라가 "접근했다" 고 말했으면 그 근거가 함께 있어야 한다. 수신할 때 프레임 한 장을
  /// 판정해 사람 박스를 붙여 둔다. 수신함 썸네일에 박스가 보이는 게 이 값이다.
  ///
  /// 이건 1차 탐지고 판정이 아니다 — 잔류도 설비 상태 결합도 없다. 그건 시퀀스 분석 몫이다.
  personCount   Int    @default(0)
  /// JSON: 정규화 박스 배열 (TrackBox)
  boxes         String @default("[]")
  /// JSON: zoneId → 그 순간 구역 안 인원
  zoneOccupancy String @default("{}")
  riskLevel     String @default("SAFE")
  modelRepo     String @default("")
  /// 탐지를 실제로 돌린 시각. 없으면 아직 탐지하지 않은 장면이다(AI 서비스가 꺼져 있었거나).
  detectedAt    DateTime?

  /// ── 안전대 착용 판정 ─────────────────────────────
  /// 위험구역 분석과 별도 버튼이다. 진입·잔류는 우리 로직이지만 안전대 착용은 남의 학습
  /// 결과(Roboflow 호스팅 추론)에 의존하므로, 한쪽이 실패해도 다른 쪽 결과는 그대로 믿을
  /// 수 있게 갈라 둔다. 그래서 provider 를 함께 저장한다 — "우리 모델" 로 읽히면 안 된다.
  ///
  /// 착용과 체결을 **따로** 저장한다. 근거의 강도가 다르다 — 착용은 통제된 A/B 쌍으로
  /// 확인했고, 체결은 미체결 표본 1장만 있다. 한 칸에 뭉치면 그 차이가 사라진다.
  ///
  /// "" (아직 안 돌림) | WORN | NOT_WORN | UNKNOWN
  harnessVerdict    String    @default("")
  harnessConfidence Float     @default(0)
  /// "" (안 물어봄 — 하네스가 없거나 판정 전) | ATTACHED | NOT_ATTACHED | UNKNOWN
  hookVerdict       String    @default("")
  hookConfidence    Float     @default(0)
  /// roboflow | local
  harnessProvider   String    @default("")
  harnessModel      String    @default("")
  /// JSON: 사람별 박스 + 착용 추정
  harnessBoxes      String    @default("[]")
  harnessAt         DateTime?
  /// 판정하지 못한 이유. 공급자가 없거나 원격이 죽었을 때 화면까지 전달한다.
  harnessError      String    @default("")
  /// 트리거를 만든 카메라·엣지 쪽 메모. 사람이 읽는 한 줄.
  note    String @default("")

  /// 마지막으로 이 장을 포함해 돌린 분석. 있으면 수신함에서 "분석됨"으로 보인다.
  lastAnalysis   VideoAnalysis? @relation(fields: [lastAnalysisId], references: [id], onDelete: SetNull)
  lastAnalysisId String?

  createdAt DateTime @default(now())

  @@index([workplaceId, capturedAt])
  @@index([cameraId, capturedAt])
}
